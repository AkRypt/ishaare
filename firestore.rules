rules_version = '2';
// Shared Firebase project (akxh-games) — namespaced per game.
// Deploy this file as the project ruleset (Console or firebase deploy).
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Spycy (client Auth + realtime) ---
    match /spycy_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /spycy_lobbies/{lobbyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
    match /spycy_words/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- Ishaare (Admin SDK only) ---
    match /ishaare_users/{uid} {
      allow read, write: if false;
    }
    match /ishaare_decks/{id} {
      allow read, write: if false;
    }
    match /ishaare_words/{id} {
      allow read, write: if false;
    }

    // Legacy flat collections — deny (data moved to namespaced names)
    match /users/{id} { allow read, write: if false; }
    match /decks/{id} { allow read, write: if false; }
    match /words/{id} { allow read, write: if false; }
    match /lobbies/{id} { allow read, write: if false; }
  }
}
